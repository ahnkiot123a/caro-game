{
  "name": "caro-online",
  "version": "1.0.0",
  "private": true,
  "description": "Realtime online Caro (Gomoku) built with Next.js 15, Socket.IO, Zustand and Upstash Redis",
  "engines": {
    "node": ">=18.18.0"
  },
  "scripts": {
    "dev": "tsx server.ts",
    "build": "next build",
    "start": "cross-env NODE_ENV=production tsx server.ts",
    "start:socket": "cross-env NODE_ENV=production tsx src/server/standalone.ts",
    "dev:socket": "tsx watch src/server/standalone.ts",
    "next:dev": "next dev",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@next/env": "^15.5.29",
    "@upstash/redis": "^1.41.0",
    "clsx": "^2.1.1",
    "cross-env": "^10.1.0",
    "next": "^15.5.29",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "socket.io": "^4.8.4",
    "socket.io-client": "^4.8.4",
    "tsx": "^4.23.15",
    "zod": "^3.25.76",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.7",
    "@tailwindcss/postcss": "^4.3.5",
    "@types/node": "^20.19.43",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "^15.5.29",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.10.1",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "^4.3.5",
    "typescript": "^5.9.0"
  }
}
