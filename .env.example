# --- Upstash Redis (optional for local dev; falls back to in-memory store when empty) ---
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- Socket server ---
# Port for `npm run dev` / `npm run start` (Next.js + Socket.IO in one process)
PORT=3000
# Comma-separated list of allowed origins for the standalone socket server (npm run start:socket)
CORS_ORIGIN=http://localhost:3000

# --- Client ---
# Leave empty to connect to the same origin (custom server). Set it when the
# frontend is on Vercel and the socket server is hosted elsewhere.
NEXT_PUBLIC_SOCKET_URL=
